# CreatorConnect Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env or secret keys to source control.

# Supabase Public Configuration (Client & SSR)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key_here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Supabase Server-Side Runtime Fallback
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key_here"
SUPABASE_PROJECT_ID="your-project-id"

# Server-Side Admin Operations (Optional / Privileged — Never add VITE_ prefix)
# SUPABASE_SERVICE_ROLE_KEY="your_service_role_key_here"

# Direct Database Connection for Drizzle Kit CLI Migrations (Optional)
# DATABASE_URL="postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres"

# Scheduled Cron Trigger Secret (Optional)
# CRON_SECRET="your_cron_secret_here"
